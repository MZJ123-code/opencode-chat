{
  "server": {
    "port": 3000,
    "hostname": "0.0.0.0"
  },
  "opencode": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },

  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-chat",
  "logLevel": "INFO",
  "autoupdate": false,

  "agent": {
    "build": {
      "temperature": 0.7
    }
  },

  "tools": {
    "bash": true,
    "write": true,
    "read": true,
    "edit": true,
    "search": true,
    "web_search": false,
    "web_fetch": false
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 8,
    "preserve_recent_tokens": 16000,
    "reserved": 8000
  },

  "tool_output": {
    "max_lines": 500,
    "max_bytes": 102400
  },

  "snapshot": true,

  "agentOptions": [
    {
      "label": "代码构建",
      "description": "编写、修改和调试代码的最佳选择，支持完整的工具链",
      "agent": "build"
    },
    {
      "label": "架构规划",
      "description": "设计系统架构和技术方案，适合前期设计和讨论",
      "agent": "plan"
    },
    {
      "label": "代码探索",
      "description": "快速了解和分析现有代码库的结构与逻辑",
      "agent": "explore"
    },
       {
      "label": "门子俊",
      "description": "快速了解和分析现有代码库的结构与逻辑",
      "agent": "explore"
    }
  ],

  "provider": {},

  "log": {
    "maxFileSize": 10485760,
    "maxArchives": 10
  }
}
